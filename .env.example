APP_NAME="Real ou 3D"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8089

APP_LOCALE=pt_BR
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=pt_BR
APP_TIMEZONE=America/Sao_Paulo

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=pgsql
# Set to true whenever the connection goes through a transaction-mode pooler
# (Neon's `-pooler` endpoint, PgBouncer, Supavisor). Without it, server-side
# prepared statements break intermittently under concurrent workers and surface
# as SQLSTATE 25P02 on the wrong statement. See config/database.php.
DB_DISABLE_PREPARES=false
DB_HOST=db
DB_PORT=5432
DB_DATABASE=quiz_app
DB_USERNAME=quiz
DB_PASSWORD=quiz

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=public
QUEUE_CONNECTION=sync

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

QUIZ_QUESTIONS_PER_ROUND=10

# Which disk holds uploaded images. `public` locally, `quiz_storage` anywhere
# the container's filesystem is ephemeral — otherwise every image is lost on the
# next deploy. Verify with `php artisan quiz:check-storage`.
QUIZ_DISK=public

# The bucket behind `quiz_storage`. Cloudflare R2 today; any S3-compatible
# provider works unchanged. These are deliberately not called AWS_*: the `s3`
# driver names a protocol, not Amazon, and no AWS account is involved.
#   REGION    always `auto` on R2.
#   ENDPOINT  the authenticated S3 API. This is what points the client at
#             Cloudflare rather than Amazon. Not browsable.
#   URL       the public hostname objects are served from — what ends up in an
#             <img src>. Without it Storage::url() returns an unresolvable path.
QUIZ_STORAGE_KEY=
QUIZ_STORAGE_SECRET=
QUIZ_STORAGE_REGION=auto
QUIZ_STORAGE_BUCKET=
QUIZ_STORAGE_ENDPOINT=
QUIZ_STORAGE_URL=
QUIZ_STORAGE_PATH_STYLE=false

VITE_APP_NAME="${APP_NAME}"
